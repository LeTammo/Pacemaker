# e.g. NEXT_PUBLIC_API_URL=https://mathia.xyz/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend server binding
API_HOST=0.0.0.0
API_PORT=8000

# If true, enables periodic automatic syncs. Keep false to only allow manual syncs.
ENABLE_AUTO_SYNC=false
