# Garmin credentials and sync pin
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password
SYNC_PIN=choose_a_private_pin

# e.g. NEXT_PUBLIC_API_URL=https://mydomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend server binding
API_HOST=0.0.0.0
API_PORT=8000

# If true, enables periodic automatic syncs. Keep false to only allow manual syncs.
ENABLE_AUTO_SYNC=false
